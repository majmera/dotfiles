function cd_sm() {
  local ticket="$1"
  local jira_base="${JIRA_BASE_URL:-https://jira.cec.lab.emc.com}"
  local issue_key
  local -a issue_keys

  if [[ -z "$ticket" ]]; then
    echo "Usage: cd_sm <ticket-id|PROJECT-12345>"
    return 1
  fi

  if [[ "$ticket" =~ '^[0-9]+$' ]]; then
    local -a projects
    local project_list="${CD_SM_PROJECTS:-PSSLDF PSSL03G}"
    projects=(${=project_list})
    local proj
    for proj in "${projects[@]}"; do
      issue_keys+=("$proj-$ticket")
    done
  else
    issue_key="$ticket"
    issue_keys=("$issue_key")
  fi

  if [[ -z "$JIRA_TOKEN" ]]; then
    echo "JIRA_TOKEN is not set"
    return 1
  fi

  local tried_keys="${(j:, :)issue_keys}"
  local -a candidates
  local -a first_found_candidates
  local first_found_key=""
  local found_any_issue=0
  local resolved_key=""
  local issue_json
  local issue_tmp

  for issue_key in "${issue_keys[@]}"; do
    issue_json=$(curl -fsS \
      -H "Authorization: Bearer $JIRA_TOKEN" \
      -H "Accept: application/json" \
      "$jira_base/rest/api/2/issue/$issue_key?expand=renderedFields,names" 2>/dev/null) || continue

    found_any_issue=1

    issue_tmp=$(mktemp) || {
      echo "Failed to create temp file"
      return 1
    }
    printf '%s' "$issue_json" >| "$issue_tmp"

    candidates=("${(@f)$(python3 - "$issue_tmp" <<'PY'
import json
import re
import sys

try:
    with open(sys.argv[1], "r", encoding="utf-8") as fh:
        data = json.load(fh)
except Exception:
    sys.exit(0)

rnames = data.get("names", {})
fields = data.get("fields", {}) or {}
rendered = data.get("renderedFields", {}) or {}

path_rx = re.compile(r'(?:(?:[A-Za-z]:)?[\\/][^\n\r"<>|]+)')
support_hint_rx = re.compile(r'(support materials|jirasupportmaterials)', re.IGNORECASE)
seen = set()
out = []

def add_candidate(raw, only_if_support_hint=False):
    if not isinstance(raw, str):
        return
    s = raw.strip()
    if not s:
        return
    s = re.sub(r'<[^>]+>', ' ', s)
    s = s.replace('&nbsp;', ' ').replace('&amp;', '&')
    if only_if_support_hint and not support_hint_rx.search(s):
        return
    for m in path_rx.findall(s):
        p = m.strip().rstrip(')].,;"\'')
        if p and p not in seen:
            seen.add(p)
            out.append(p)

def walk(v, only_if_support_hint=False):
    if isinstance(v, dict):
        for vv in v.values():
            walk(vv, only_if_support_hint=only_if_support_hint)
    elif isinstance(v, list):
        for vv in v:
            walk(vv, only_if_support_hint=only_if_support_hint)
    elif isinstance(v, str):
        add_candidate(v, only_if_support_hint=only_if_support_hint)

# Prefer explicitly named "Support Materials" fields first.
support_field_ids = [
    fid for fid, name in rnames.items()
    if isinstance(name, str) and "support materials" in name.lower()
]

for fid in support_field_ids:
    if fid in fields:
        walk(fields[fid], only_if_support_hint=False)
    if fid in rendered:
        walk(rendered[fid], only_if_support_hint=False)

# Fallback: scan all fields and rendered fields.
if not out:
    walk(fields, only_if_support_hint=True)
    walk(rendered, only_if_support_hint=True)

print("\n".join(out))
PY
)}")
    rm -f "$issue_tmp"

    candidates=("${(@)candidates:#}")

    if (( ${#candidates[@]} == 0 )); then
      continue
    fi

    if [[ -z "$first_found_key" ]]; then
      first_found_key="$issue_key"
      first_found_candidates=("${candidates[@]}")
    fi

    local p
    for p in "${candidates[@]}"; do
      p="${p%/}"
      if [[ -d "$p" ]]; then
        resolved_key="$issue_key"
        cd "$p"
        pwd
        return 0
      fi
    done
  done

  if (( ! found_any_issue )); then
    if [[ "$ticket" =~ '^[0-9]+$' ]]; then
      echo "Failed to fetch Jira issue for any of: $tried_keys"
    else
      echo "Failed to fetch Jira issue: $ticket"
    fi
    return 1
  fi

  if [[ -z "$first_found_key" ]]; then
    if [[ "$ticket" =~ '^[0-9]+$' ]]; then
      echo "No Support Materials path found in any of: $tried_keys"
    else
      echo "No Support Materials path found in $ticket"
    fi
    return 1
  fi

  echo "Found Support Materials path(s), but none exist on this machine:"
  echo "  issue: $first_found_key"
  printf '  %s\n' "${first_found_candidates[@]}"
  return 1
}
